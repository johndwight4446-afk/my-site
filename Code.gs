    .rule{height:3px;margin:4px 0;background:linear-gradient(90deg,#0b2a5b 0 68%,#08a9d2 68% 88%,#f2b705 88%)}
    .meta{display:flex;justify-content:space-between;gap:8px;margin:0 0 4px;padding:4px 7px;background:#f1f5fa;border-left:3px solid #08a9d2}
    .meta span{flex:1;font-size:7pt}.meta b{display:block;margin-bottom:1px;color:#53627b;font-size:5.7pt;letter-spacing:.5px}
    .title{text-align:center;border-bottom:1px solid #cbd6e5;padding:0 0 4px;margin-bottom:4px}
