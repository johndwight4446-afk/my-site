    '</style></head><body><header class="head"><p class="kicker">OFFICIAL ADMISSIONS DOCUMENT · ADMISSIONS OFFICE</p><h1>' +
    escapeHtml(CFG.INSTITUTION) + '</h1><div>LETTER OF ACCEPTANCE</div></header>' +
