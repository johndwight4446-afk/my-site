const LOGO_WATERMARK_PNG_BASE64 = '';
const OFFICIAL_STAMP_PNG_BASE64 = '';

const SEMESTER_GROUPS = ['Semester 1 and 2', 'Semester 3 and 4', 'Semester 5 and 6', 'Semester 7 and 8'];
const PROGRAM_NAMES = [
