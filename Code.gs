function acceptanceLetterPdf(student, feeSchedule, date, bankAccounts) {
  const accountsList = bankAccounts || [];
  const accounts = accountsList.map(account =>
    '<tr><td>' + escapeHtml(account.bankName) + '</td><td>' + escapeHtml(account.accountNumber) + '</td></tr>').join('');
  const programmes = escapeHtml(String(student.Programmes || 'To be confirmed').replace(/\s*\|\s*/g, ', '));
