    <footer class="footer"><b>${escapeHtml(CFG.INSTITUTION)}</b><br>${escapeHtml(CFG.ADDRESS)}, Sierra Leone · ${escapeHtml(CFG.CONTACTS)}
      <br><b>Email:</b> ${escapeHtml(CFG.EMAILS)}</footer></body></html>`;
  return HtmlService.createHtmlOutput(html).getAs(MimeType.PDF)
    .setName('Acceptance Letter - ' + String(student.RegistrationNumber).replace(/[^\w-]/g, '_') + '.pdf');
}
function paymentEmailText(receipt) {
  const lines = [
    'PAYMENT RECEIPT',
    'Receipt number: ' + receipt.receiptNumber,
    'Date: ' + receipt.date,
    'Student ID: ' + receipt.studentId,
    'Programme: ' + receipt.program,
    'Semester group: ' + receipt.semesterGroup,
    'Recorded by: ' + (receipt.recordedBy || ''),
    'Payments received this time:'
  ];
  receipt.currentInstallments.forEach(item => lines.push('  Installment ' + item.number +
    (item.date ? ' (' + item.date + ')' : '') + ': ' + moneyText(item.amount)));
  lines.push('Amount paid this time: ' + moneyText(receipt.amountPaid));
  lines.push('Previous payments for this semester group:');
  if (receipt.previousInstallments.length) {
    receipt.previousInstallments.forEach(item => lines.push('  Installment ' + item.number +
      (item.date ? ' (' + item.date + ')' : '') + ': ' + moneyText(item.amount)));
  } else {
    lines.push('  None');
  }
  lines.push('Total paid for this semester group: ' + moneyText(receipt.totalPaid));
  lines.push('Total fees for this semester group: ' + moneyText(receipt.totalFees));
  lines.push('Remaining balance: ' + moneyText(receipt.balance));
  return lines.join('\n');
}
