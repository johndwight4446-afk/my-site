    '.authority{display:flex;align-items:center;justify-content:flex-end;gap:14px;margin-top:8px;text-align:right;font-size:8pt;break-inside:avoid}' +
    '.authority .stamp{width:90px;height:78px;object-fit:contain}.footer{border-top:1px solid #d9e0ec;margin-top:7px;padding-top:4px;text-align:center;color:#53627b;font-size:7pt}' +
    '</style></head><body><header class="header"><h1>' + escapeHtml(CFG.INSTITUTION) +
    '</h1><p>OFFICIAL FEE PAYMENT RECEIPT</p></header><div class="number"><b>Receipt number:</b> ' +
    escapeHtml(receipt.receiptNumber) + '</div><div class="details"><p><b>Student:</b> ' + escapeHtml(receipt.name) +
    '</p><p><b>Student ID:</b> ' + escapeHtml(receipt.studentId) + '</p><p><b>Registration number:</b> ' +
    escapeHtml(receipt.registrationNumber) + '</p><p><b>Date:</b> ' + escapeHtml(receipt.date) + '</p><p><b>Programme:</b> ' +
    escapeHtml(receipt.program) + '</p><p><b>Semester group:</b> ' + escapeHtml(receipt.semesterGroup) +
    '</p><p><b>Recorded by:</b> ' + escapeHtml(receipt.recordedBy || '') + '</p></div><h2>Payment received this time</h2>' +
    '<table><thead><tr><th>Payment</th><th>Date</th><th class="num">Amount</th></tr></thead><tbody>' + current +
    '</tbody><tfoot><tr><td colspan="2">Amount paid this time</td><td class="num">' + escapeHtml(moneyText(receipt.amountPaid)) +
    '</td></tr></tfoot></table><h2>Previous payments</h2><table><thead><tr><th>Payment</th><th>Date</th><th class="num">Amount</th></tr></thead><tbody>' +
    (previous || '<tr><td colspan="3">No previous payments</td></tr>') + '</tbody></table><div class="totals">' +
    '<div><small>Paid this time</small>' + escapeHtml(moneyText(receipt.amountPaid)) + '</div><div><small>Total paid to date</small>' +
    escapeHtml(moneyText(receipt.totalPaid)) + '</div><div><small>Total semester fees</small>' + escapeHtml(moneyText(receipt.totalFees)) +
    '</div><div><small>Outstanding balance</small>' + escapeHtml(moneyText(receipt.balance)) +     '</div></div><div class="authority"><img class="stamp" src="' + stamp + '" alt="Official institution stamp"></div>' +
    '<footer class="footer"><b>Address:</b> ' + escapeHtml(CFG.ADDRESS) + ' · <b>Contacts:</b> ' + escapeHtml(CFG.CONTACTS) +
    '<br><b>Email:</b> ' + escapeHtml(CFG.EMAILS) + '</footer></body></html>';
  return HtmlService.createHtmlOutput(html).getAs(MimeType.PDF)
    .setName('Payment Receipt - ' + String(receipt.receiptNumber).replace(/[^\w-]/g, '_') + '.pdf');
}
function escapeHtml(value) {
  return String(value || '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}
function formatEmailMessage(message) {
  return String(message || '').split('\n').map((line, index) => {
    const text = escapeHtml(line);
    if (!text) return '<div style="height:8px"></div>';
    if (index === 0) return '<h2 style="margin:0 0 16px;color:#0b2a5b;font-size:18px">' + text + '</h2>';
    const detail = text.match(/^([^:]+):\s*(.*)$/);
    if (detail) return '<div style="display:flex;gap:14px;padding:8px 10px;border-bottom:1px solid #e3e8f0">' +
      '<b style="min-width:190px;color:#53627b">' + detail[1] + '</b><span style="color:#10213f">' + detail[2] + '</span></div>';
    if (/^\s/.test(line)) return '<div style="padding:5px 10px 5px 24px;color:#35445d">' + text + '</div>';
    return '<p style="line-height:1.6;margin:8px 0;color:#35445d">' + text + '</p>';
  }).join('');
}

function studentEmailRecipients(student) {
  const emailPattern = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
  return [student.Email, student.GuardianEmail]
    .map(value => String(value || '').trim().toLowerCase())
    .filter((value, index, list) => emailPattern.test(value) && list.indexOf(value) === index);
}

function sendStudentEmail(student, subject, message, attachments, recipientEmails) {
  const emailPattern = /^[^@\s]+@[^@\s]+\.[^@\s]+$/;
  const recipients = (recipientEmails || studentEmailRecipients(student))
    .map(value => String(value || '').trim().toLowerCase())
    .filter((value, index, list) => emailPattern.test(value) && list.indexOf(value) === index);
  if (!recipients.length) return { sent: false, error: 'No valid student or parent/guardian email address was provided' };
  const htmlBody = '<div style="font-family:Arial,sans-serif;max-width:620px;margin:auto;color:#10213f">' +
    '<div style="background:#0b2a5b;color:#fff;padding:22px;text-align:center"><b style="font-size:20px;color:#f2b705">FBITI</b><br>' +
    escapeHtml(CFG.INSTITUTION) + '</div><div style="padding:24px"><p>Dear ' + escapeHtml(student.FullName) + ',</p>' +
    '<div style="border:1px solid #e3e8f0;border-radius:10px;padding:16px;background:#fbfcff">' + formatEmailMessage(message) + '</div>' +
    '<div style="margin-top:16px;padding:12px;background:#eef2f9;border-radius:8px"><b>Registration number:</b> ' +
    escapeHtml(student.RegistrationNumber) + (student.StudentID ? '<br><b>Student ID:</b> ' + escapeHtml(student.StudentID) : '') +
    '</div><p style="margin-top:18px">FutureBridge Institute of Technology &amp; Innovation</p></div></div>';
  try {
    const body = 'Dear ' + student.FullName + ',\n\n' + message + '\n\nRegistration number: ' +
      student.RegistrationNumber + (student.StudentID ? '\nStudent ID: ' + student.StudentID : '') +
      '\n\nFutureBridge Institute of Technology & Innovation';
    const options = { to: recipients[0], subject: subject, body: body, htmlBody: htmlBody, name: 'FBITI' };
    if (recipients.length > 1) options.cc = recipients.slice(1).join(',');
    if (attachments && attachments.length) options.attachments = attachments;
    MailApp.sendEmail(options);
    return { sent: true, error: '' };
  } catch (error) {
    return { sent: false, error: String(error.message || error) };
  }
}

function sendApplicationLinkEmail(payment, applicationLink) {
  try {
    const subject = 'FBITI – Student registration form link';
    const body = 'Dear ' + payment['Full Name'] + ',\n\n' +
      'Complete your student registration form using this private link: ' + applicationLink + '\n\n' +
      'Your name and programme are already filled in and cannot be changed. This link is for completing your registration form only.\n\n' +
      CFG.INSTITUTION;
    const htmlBody = '<div style="font-family:Arial,sans-serif;max-width:620px;margin:auto;color:#10213f">' +
      '<div style="background:#0b2a5b;color:#fff;padding:20px;text-align:center;border-bottom:4px solid #f2b705">' +
      '<b style="font-size:18px">' + escapeHtml(CFG.INSTITUTION) + '</b></div><div style="padding:24px">' +
      '<p>Dear ' + escapeHtml(payment['Full Name']) + ',</p><p>Complete your student registration form using the private link below.</p>' +
      '<p><a href="' + escapeHtml(applicationLink) + '" style="display:inline-block;background:#0b2a5b;color:#fff;padding:12px 18px;border-radius:8px;text-decoration:none">Complete your application</a></p>' +
      '<p>Your name and programme are already filled in and cannot be changed. This link is for completing your registration form only.</p>' +
      '<p>' + escapeHtml(CFG.INSTITUTION) + '</p></div></div>';
    MailApp.sendEmail({
      to: payment.Email, subject: subject, body: body, htmlBody: htmlBody, name: 'FBITI'
    });
    return { sent: true, error: '' };
  } catch (error) {
    return { sent: false, error: String(error.message || error) };
  }
}

function sendStatusMail(user, approved) {
  const color = approved ? '#16833a' : '#b42318';
  const title = approved ? 'Your account has been approved' : 'Your registration was not approved';
  const msg = approved
    ? 'Good news! The administrator has approved your account. You can now sign in with your username and password.'
    : 'We regret to inform you that your registration request was not approved. If you believe this is a mistake, please contact the administrator.';
  const body = 'Dear ' + user.FullName + ',\n\n' + msg + '\n\nUsername: ' + user.Username +
    ' | Role: ' + user.Role + '\n\n' + CFG.INSTITUTION + '\nAutomated message – please do not reply.';
  const html = '<div style="font-family:Arial,sans-serif;max-width:560px;margin:auto;border:1px solid #e3e8f0;border-radius:12px;overflow:hidden">' +
    '<div style="background:#0b2a5b;color:#fff;padding:24px;text-align:center"><div style="font-size:13px;letter-spacing:2px;color:#f2b705">FBITI</div>' +
    '<div style="font-size:16px;margin-top:6px">' + escapeHtml(CFG.INSTITUTION) + '</div></div>' +
    '<div style="padding:28px;color:#10213f"><div style="display:inline-block;background:' + color + ';color:#fff;padding:6px 14px;border-radius:20px;font-size:13px;font-weight:bold">' +
    (approved ? 'APPROVED' : 'DENIED') + '</div><h2 style="margin:16px 0 8px">' + escapeHtml(title) + '</h2>' +
    '<p>Dear ' + escapeHtml(user.FullName) + ',</p><p style="line-height:1.6">' + escapeHtml(msg) + '</p>' +
    '<p style="margin-top:24px;color:#5b6b86;font-size:13px">Username: <b>' + escapeHtml(user.Username) + '</b> &nbsp;|&nbsp; Role: <b>' + escapeHtml(user.Role) + '</b></p></div>' +
    '<div style="background:#f4f6fa;padding:14px;text-align:center;font-size:12px;color:#5b6b86">This is an automated message – please do not reply.</div></div>';
  MailApp.sendEmail({ to: user.Email, subject: 'FBITI – ' + title, body: body, htmlBody: html, name: 'FBITI System' });
}
