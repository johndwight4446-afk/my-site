  'AcceptanceEmailSent','AcceptanceEmailError','RegistrationEmailSent','RegistrationEmailError'];
const PAY_FIELDS = [];
for (let i = 1; i <= 5; i++) PAY_FIELDS.push('P' + i + '_Amount', 'P' + i + '_Date', 'P' + i + '_Bank', 'P' + i + '_Slip');

const SCHEMA = {
  'USERS': ['UserID','FullName','Email','Username','PasswordHash','Salt','Role','Status','CreatedAt','UpdatedAt'],
  'STUDENTS': STUDENT_FIELDS,
  'Form Payment': ['Full Name','Program','Email','Recorded By','FormTokenHash','Status','RegistrationNumber','CreatedAt'],
  'ACOUNT NUMBER': ['Bank Name','Account Number'],
  'FEES PAYMENT': ['FeeID','RegistrationNumber','StudentID','Name','Program','SemesterGroup','TotalFees'].concat(PAY_FIELDS,
    ['TotalPaid','Balance','RecordedBy','Status','VoidReason','VoidedBy','ClientRef','CreatedAt','UpdatedAt','PaymentEmailSent','PaymentEmailError','LastReceipt','ReceiptHistory']),
  'PROGRAMME FEES': ['Program','SemesterGroup','TotalFees','UpdatedAt','UpdatedBy'],
  'EXPENDITURE': ['ExpID','Date','Name','Description','Amount','RecordedBy','Status','VoidReason','VoidedBy','ClientRef','CreatedAt'],
  'RECYCLE BIN': ['BinID','Type','OriginalID','Label','DeletedBy','DeletedAt','Data'],
  'AUDIT LOG': ['Time','User','Action','Detail']
};

/* ---------- Entry points ---------- */
function setup() {
  Object.keys(SCHEMA).forEach(name => formatSheet(sh(name), true));
  assignMissingRegistrationNumbers();
}

function onOpen() {
  formatSheet(sh('Form Payment'), true);
  formatSheet(sh('ACOUNT NUMBER'), true);
  SpreadsheetApp.getUi().createMenu('FBITI Admin')
    .addItem('Reset password for selected user', 'showUserPasswordDialog')
    .addItem('Format and repair all sheets', 'setup')
    .addToUi();
}

function onEdit(e) {
  const sheet = e && e.range && e.range.getSheet();
  if (!sheet) return;
  const schema = SCHEMA[sheet.getName()];
  if (!schema) return;
  formatSheet(sh(sheet.getName()), false, e.range.getRow(), e.range.getNumRows());
}

function showUserPasswordDialog() {
  const sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
  const row = sheet.getActiveRange() && sheet.getActiveRange().getRow();
  if (sheet.getName() !== 'USERS' || !row || row < 2) {
    SpreadsheetApp.getUi().alert('Select a user row in the USERS sheet first.');
    return;
  }
  const user = rows('USERS').find(r => r._row === row);
  if (!user) {
    SpreadsheetApp.getUi().alert('The selected user was not found.');
    return;
  }
  const html = HtmlService.createHtmlOutput(
    '<!doctype html><html><body style="font:14px Arial,sans-serif;padding:16px;color:#10213f">' +
    '<form id="form"><input id="userId" type="hidden" value="' + escapeHtml(user.UserID) + '">' +
    '<p>Set a new password for <b>' + escapeHtml(user.FullName) + '</b>.</p>' +
    '<label>New password (at least 6 characters)<br><input id="password" type="password" minlength="6" required autofocus style="width:100%;padding:8px;margin-top:8px;box-sizing:border-box"></label>' +
    '<p id="message" style="min-height:18px;color:#b42318"></p><button id="submit" type="submit">Update password</button></form>' +
    '<script>document.getElementById("form").onsubmit=function(e){e.preventDefault();var b=document.getElementById("submit"),m=document.getElementById("message");b.disabled=true;m.textContent="Updating…";' +
    'google.script.run.withSuccessHandler(function(){m.style.color="#16833a";m.textContent="Password updated.";document.getElementById("form").reset();b.disabled=false;})' +
    '.withFailureHandler(function(err){m.textContent=err.message;b.disabled=false;})' +
    '.setUserPasswordFromSheet(document.getElementById("userId").value,document.getElementById("password").value);};</script></body></html>'
  ).setWidth(360).setHeight(220);
  SpreadsheetApp.getUi().showModalDialog(html, 'Reset user password');
}

function setUserPasswordFromSheet(id, password) {
  const t = rows('USERS').find(r => r.UserID === id);
  if (!t) throw new Error('User not found');
  if (String(password || '').length < 6) throw new Error('Password must be at least 6 characters');
  t.Salt = Utilities.getUuid();
  t.PasswordHash = hash(String(password), t.Salt);
  t.UpdatedAt = now();
  setRow('USERS', t._row, t);
  audit({ username: t.Username }, 'USER_PASSWORD_UPDATE', t.UserID);
  return true;
}

function doGet(e) {
  const token = e && e.parameter && e.parameter.apply;
  if (!token) return out({ ok: true, data: 'FBITI API is running' });
  try {
    const application = ACTIONS.getApplicationForm({ token: token });
    if (application.completed) return HtmlService.createHtmlOutput(applicationCompleteHtml(application));
    return HtmlService.createHtmlOutput(applicationFormHtml(token, application))
      .setTitle('Student Admission Form - ' + CFG.INSTITUTION)
      .addMetaTag('viewport', 'width=device-width, initial-scale=1');
  } catch (error) {
    return HtmlService.createHtmlOutput(applicationErrorHtml(error.message))
      .setTitle('Student Admission Form - ' + CFG.INSTITUTION)
      .addMetaTag('viewport', 'width=device-width, initial-scale=1');
  }
}

function submitPublicApplicationForm(token, student) {
  const lock = LockService.getScriptLock();
  let locked = false;
  try {
    lock.waitLock(25000);
    locked = true;
    return ACTIONS.submitApplicationForm({ token: token, student: student || {} });
  } finally {
    if (locked) lock.releaseLock();
  }
}

