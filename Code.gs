    .title h2{font-size:17pt;letter-spacing:.6px;color:#0b2a5b;margin:2px 0}
    .title p:last-child{font-size:6.5pt;font-weight:bold;letter-spacing:1px;color:#53627b;margin:0}
    p{margin:7px 0}
    .details{display:grid;grid-template-columns:1fr 1fr 1.5fr 1fr;gap:6px;margin:5px 0;padding:5px 7px;background:rgba(238,242,249,.93);border:1px solid #d9e0ec}
    .details div{min-width:0}.details small{display:block;color:#53627b;font-weight:bold;font-size:5.7pt;margin-bottom:2px}
    .details b{font-size:7.3pt;overflow-wrap:anywhere}
