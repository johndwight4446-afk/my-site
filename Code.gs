function doPost(e) {
  const lock = LockService.getScriptLock();
  const requestId = Utilities.getUuid().slice(0, 8).toUpperCase();
  let locked = false;
  try {
    if (!e || !e.postData || typeof e.postData.contents !== 'string')
      throw new Error('Request body is required');
    let req;
    try { req = JSON.parse(e.postData.contents); }
    catch (error) { throw new Error('Request body must be valid JSON'); }
    if (!req || typeof req !== 'object' || Array.isArray(req))
      throw new Error('Request body must be a JSON object');
    const action = typeof req.action === 'string' ? req.action.trim() : '';
    if (!action) throw new Error('Action is required');
    if (!Object.prototype.hasOwnProperty.call(ACTIONS, action))
      throw new Error('Unknown action');
    const fn = ACTIONS[action];
    if (typeof fn !== 'function') throw new Error('Unknown action');
    const data = req.data === undefined || req.data === null ? {} : req.data;
    if (typeof data !== 'object' || Array.isArray(data))
      throw new Error('Action data must be a JSON object');

    lock.waitLock(25000);
    locked = true;
    const user = PUBLIC[action] ? null : session(req.token);
    return out({ ok: true, data: fn(data, user, req.token) });
  } catch (error) {
    const message = String(error && error.message || error || 'Request failed');
    Logger.log('API request ' + requestId + ' failed: ' + message +
      (error && error.stack ? '\n' + error.stack : ''));
    return out({ ok: false, error: message, requestId: requestId });
  } finally {
    if (locked) lock.releaseLock();
  }
}

const out = o => ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON);

/* ---------- Sheet helpers ---------- */
function sh(name) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  let s = ss.getSheetByName(name);
  if (!s && name === 'Form Payment') {
    s = ss.getSheetByName('FORM PAYMENTS');
    if (s) s.setName(name);
  }
  s = s || ss.insertSheet(name);
  const h = SCHEMA[name];
  const lastColumn = s.getLastColumn();
  const existing = lastColumn
    ? s.getRange(1, 1, 1, lastColumn).getDisplayValues()[0].map(v => String(v).trim())
    : [];
  const currentHeaders = existing.filter(Boolean);
  const desiredHeaders = name === 'Form Payment' ? h : h.concat(currentHeaders.filter(k => h.indexOf(k) < 0));
  const headersMatch = desiredHeaders.length === existing.length &&
    desiredHeaders.every((header, i) => header === existing[i]);

  if (!headersMatch) {
    const lastRow = s.getLastRow();
    const data = lastRow > 1 && lastColumn
      ? s.getRange(2, 1, lastRow - 1, lastColumn).getValues()
      : [];
    const migrated = data.map(row => desiredHeaders.map(header => {
      let oldIndex = existing.indexOf(header);
      if (name === 'Form Payment' && header === 'Full Name' && oldIndex < 0)
        oldIndex = existing.indexOf('ApplicantName');
      if (name === 'Form Payment' && header === 'Email' && oldIndex < 0)
        oldIndex = existing.indexOf('LinkEmail');
      if (oldIndex < 0) return '';
      const value = row[oldIndex];
      return name === 'Form Payment' && header === 'Status' && value === 'Paid - Form pending'
        ? 'Form pending' : value;
    }));
    if (s.getMaxColumns() < desiredHeaders.length)
      s.insertColumnsAfter(s.getMaxColumns(), desiredHeaders.length - s.getMaxColumns());
    s.clearContents();
    s.getRange(1, 1, 1, desiredHeaders.length).setValues([desiredHeaders]);
    if (migrated.length) s.getRange(2, 1, migrated.length, desiredHeaders.length).setValues(migrated);
    formatSheet(s, true);
  }
  return s;
}

function formatSheet(sheet, setWidths, startRow, rowCount) {
  const name = sheet.getName();
  const headers = SCHEMA[name];
  if (!headers) return sheet;
  const lastColumn = Math.max(headers.length, sheet.getLastColumn());
  const header = sheet.getRange(1, 1, 1, lastColumn);
  header.setFontFamily('Arial').setFontSize(10).setFontWeight('bold')
    .setBackground('#0b2a5b').setFontColor('#ffffff')
    .setHorizontalAlignment('center').setVerticalAlignment('middle')
    .setWrap(true).setBorder(true, true, true, true, true, true, '#f2b705', SpreadsheetApp.BorderStyle.SOLID);
  sheet.setFrozenRows(1);
  sheet.setRowHeight(1, 36);

  if (setWidths) {
    for (let column = 1; column <= lastColumn; column++) {
      const field = String(sheet.getRange(1, column).getValue() || '');
      const width = /Description|Address|Detail|Reason|Data/i.test(field) ? 260
        : /Email/i.test(field) ? 220
        : /Name|Username|StudentID|UserID|RecordedBy/i.test(field) ? 180
        : /Date|Time|CreatedAt|UpdatedAt/i.test(field) ? 160
        : 130;
      sheet.setColumnWidth(column, width);
    }
  }
  if (name === 'Form Payment' && sheet.getMaxColumns() > 4)
    sheet.hideColumns(5, sheet.getMaxColumns() - 4);

  const lastRow = sheet.getLastRow();
  if (lastRow < 2) return sheet;
  const first = Math.max(2, startRow || 2);
  const count = rowCount === undefined ? lastRow - first + 1 : Math.min(rowCount, lastRow - first + 1);
  if (count > 0) {
    const data = sheet.getRange(first, 1, count, lastColumn);
    data.setFontFamily('Arial').setFontSize(10).setVerticalAlignment('top').setWrap(true);
    sheet.autoResizeRows(first, count);
  }
  return sheet;
}

function rows(name) {
  const v = sh(name).getDataRange().getValues();
  const h = v[0];
  return v.slice(1).map((r, i) => { const o = { _row: i + 2 }; h.forEach((k, j) => o[k] = r[j]); return o; })
    .filter(o => h.some(k => o[k] !== ''));
}
function toRow(name, obj) { return SCHEMA[name].map(k => obj[k] === undefined ? '' : obj[k]); }
function addRow(name, obj) {
  const s = sh(name), r = s.getLastRow() + 1, n = SCHEMA[name].length;
  s.getRange(r, 1, 1, n).setNumberFormat('@').setValues([toRow(name, obj)]);
  formatSheet(s, false, r, 1);
}
function setRow(name, row, obj) {
  const n = SCHEMA[name].length;
  const s = sh(name);
  s.getRange(row, 1, 1, n).setNumberFormat('@').setValues([toRow(name, obj)]);
  formatSheet(s, false, row, 1);
}
const clean = o => { const c = Object.assign({}, o); delete c._row; return c; };
const now = () => new Date().toISOString();
const today = () => Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'yyyy-MM-dd');
const num = v => Number(v) || 0;
const split = v => String(v || '').split(/\s*\|\s*|[\r\n,;]+/).map(value => value.trim()).filter(Boolean);
function normalizeProgramme(value) {
  return String(value || '').trim().toLowerCase().replace(/\s+/g, ' ');
}
function normalizeSemesterGroup(value) {
  const match = String(value || '').trim().match(/^semester\s*(\d+)\s*(?:and|&|-)\s*(\d+)$/i);
  return match ? 'Semester ' + match[1] + ' and ' + match[2] : String(value || '').trim();
}
function programmeGroups(program) {
  const index = PROGRAM_NAMES.indexOf(program);
  return index < 0 ? [] : index < 13 ? SEMESTER_GROUPS.slice(0, 1) : SEMESTER_GROUPS.slice(0, 3);
}
const uid8 = () => Utilities.getUuid().slice(0, 8).toUpperCase();
function audit(u, action, detail) { addRow('AUDIT LOG', { Time: now(), User: u ? u.username : '-', Action: action, Detail: detail || '' }); }
function tokenDigest(token) {
  const value = String(token || '').trim();
  if (!value) return '';
  return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, value, Utilities.Charset.UTF_8)
    .map(b => ('0' + (b & 0xff).toString(16)).slice(-2)).join('');
}
function findFormPaymentByToken(token) {
  const digest = tokenDigest(token);
  return digest ? rows('Form Payment').find(row => row.FormTokenHash === digest) : null;
}
function bankAccountList() {
  return rows('ACOUNT NUMBER').map(row => ({
    bankName: String(row['Bank Name'] || ''),
    accountNumber: String(row['Account Number'] || '')
  }));
}
function validateApplicationSubmission(student) {
  student.Email = String(student.Email || '').trim().toLowerCase();
  if (!/^\d{4}\/\d{4}$/.test(String(student.AcademicYear || '')))
    throw new Error('Academic year must look like 2026/2027');
  if (!student.FullName || !['Male', 'Female'].includes(student.Gender) || !student.DOB ||
      !student.Nationality || !student.Mobile || !student.Programmes)
    throw new Error('Complete all required application fields');
  if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(student.Email))
    throw new Error('Enter a valid email address for your acceptance letter');
  const birthDate = new Date(String(student.DOB) + 'T00:00:00Z');
  if (Number.isNaN(birthDate.getTime()) || birthDate.toISOString().slice(0, 10) !== String(student.DOB) ||
      birthDate.getTime() > Date.now())
    throw new Error('Enter a valid date of birth');
  const currentDate = new Date();
  let age = currentDate.getUTCFullYear() - birthDate.getUTCFullYear();
  if (currentDate.getUTCMonth() < birthDate.getUTCMonth() ||
      (currentDate.getUTCMonth() === birthDate.getUTCMonth() && currentDate.getUTCDate() < birthDate.getUTCDate())) age--;
  student.Age = String(age);
  if (Number.isFinite(age) && age < 18 && (!student.GuardianName || !student.GuardianContact))
    throw new Error('Parent/Guardian name and contact are required for applicants under 18');
}
function need(u, role) {
  const allowed = role === 'Admin' ? u.role === 'Master Admin' : u.role === role;
  if (!allowed) throw new Error('You do not have permission for this action');
}

/* ---------- Security ---------- */
function hash(pw, salt) {
  return Utilities.computeDigest(Utilities.DigestAlgorithm.SHA_256, salt + pw, Utilities.Charset.UTF_8)
    .map(b => ('0' + (b & 0xff).toString(16)).slice(-2)).join('');
}
function session(token) {
  const raw = token && CacheService.getScriptCache().get('S_' + token);
  if (!raw) throw new Error('SESSION_EXPIRED');
  const s = JSON.parse(raw);
  ensureMasterAdmin();
  const u = rows('USERS').find(r => r.UserID === s.id);
  if (!u || u.Status !== 'Approved') throw new Error('SESSION_EXPIRED');
  return { id: u.UserID, fullName: u.FullName, username: u.Username, role: u.Role, email: u.Email };
}

function ensureMasterAdmin() {
  const users = rows('USERS');
  if (users.some(r => r.Role === 'Master Admin' && r.Status === 'Approved')) return '';
  const firstAdmin = users.filter(r => r.Role === 'Admin' && r.Status === 'Approved')
    .sort((a, b) => String(a.CreatedAt || '').localeCompare(String(b.CreatedAt || '')) || a._row - b._row)[0];
  if (!firstAdmin) return '';
  firstAdmin.Role = 'Master Admin';
  firstAdmin.UpdatedAt = now();
  setRow('USERS', firstAdmin._row, firstAdmin);
  audit({ username: firstAdmin.Username }, 'MASTER_ADMIN_MIGRATION', firstAdmin.UserID);
  return firstAdmin.UserID;
}

/* ---------- Actions ---------- */
const PUBLIC = { register: 1, login: 1, getApplicationForm: 1, submitApplicationForm: 1 };
const ACTIONS = {

  register(d) {
    const fullName = (d.fullName || '').trim(), email = (d.email || '').trim().toLowerCase();
    const username = (d.username || '').trim(), pw = d.password || '';
    if (!fullName || !email || !username || !pw || !d.role) throw new Error('All fields are required');
    if (['Admin', 'Bursar'].indexOf(d.role) < 0) throw new Error('Invalid role');
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) throw new Error('Enter a valid email address');
    if (pw.length < 6) throw new Error('Password must be at least 6 characters');
    const users = rows('USERS');
    if (users.some(u => String(u.Username).toLowerCase() === username.toLowerCase())) throw new Error('Username already taken');
    if (users.some(u => String(u.Email).toLowerCase() === email)) throw new Error('Email already registered');
    const first = users.length === 0;
    const salt = Utilities.getUuid();
    addRow('USERS', { UserID: 'USR-' + uid8(), FullName: fullName, Email: email, Username: username,
      PasswordHash: hash(pw, salt), Salt: salt, Role: first ? 'Master Admin' : d.role,
      Status: first ? 'Approved' : 'Pending', CreatedAt: now(), UpdatedAt: now() });
    audit({ username: username }, 'REGISTER', first ? 'First user auto-approved as Master Admin' : 'Awaiting approval');
    return { autoApproved: first };
  },

  login(d) {
    const migratedId = ensureMasterAdmin();
    const u = rows('USERS').find(r => String(r.Username).toLowerCase() === String(d.username || '').trim().toLowerCase());
    if (!u || hash(d.password || '', u.Salt) !== u.PasswordHash) throw new Error('Invalid username or password');
    if (u.Role !== d.role && !(u.UserID === migratedId && d.role === 'Admin'))
      throw new Error('This account is not registered with the selected role');
    if (u.Status === 'Pending') throw new Error('Your account is awaiting administrator approval');
    if (u.Status === 'Denied') throw new Error('Your registration was denied. Please contact the administrator');
    const token = Utilities.getUuid() + Utilities.getUuid();
    CacheService.getScriptCache().put('S_' + token, JSON.stringify({ id: u.UserID }), CFG.SESSION_SECONDS);
    audit({ username: u.Username }, 'LOGIN', '');
    return { token: token, user: { id: u.UserID, fullName: u.FullName, username: u.Username, role: u.Role, email: u.Email } };
  },

  logout(d, u, token) { CacheService.getScriptCache().remove('S_' + token); return true; },

  me(d, u) { return u; },

  getDocumentAssets(d, u) {
    return { stampDataUri: officialStampDataUri() };
  },

  /* ----- Profile ----- */
  updateProfile(d, u) {
    const rec = rows('USERS').find(r => r.UserID === u.id);
    if (d.newUsername && d.newUsername.trim() !== rec.Username) {
      const nu = d.newUsername.trim();
      if (nu.length < 3) throw new Error('Username is too short');
      if (rows('USERS').some(r => r.UserID !== u.id && String(r.Username).toLowerCase() === nu.toLowerCase())) throw new Error('Username already taken');
      rec.Username = nu;
    }
    if (d.newPassword) {
      if (hash(d.oldPassword || '', rec.Salt) !== rec.PasswordHash) throw new Error('Old password is incorrect');
      if (d.newPassword.length < 6) throw new Error('New password must be at least 6 characters');
      rec.Salt = Utilities.getUuid(); rec.PasswordHash = hash(d.newPassword, rec.Salt);
    }
    rec.UpdatedAt = now(); setRow('USERS', rec._row, rec);
    audit(u, 'PROFILE_UPDATE', '');
    return { username: rec.Username };
  },

  /* ----- Admin: users ----- */
  updateUserAccount(d, u) {
    need(u, 'Admin');
    const t = rows('USERS').find(r => r.UserID === d.id);
    if (!t) throw new Error('User not found');
    const fullName = String(d.fullName || '').trim(), username = String(d.username || '').trim();
    if (!fullName || !username) throw new Error('Full name and username are required');
    if (username.length < 3) throw new Error('Username must be at least 3 characters');
    if (rows('USERS').some(r => r.UserID !== t.UserID && String(r.Username).toLowerCase() === username.toLowerCase()))
      throw new Error('Username already taken');
    if (d.role !== undefined) {
      if (t.UserID === u.id) throw new Error('You cannot change your own role');
      if (['Master Admin', 'Admin', 'Bursar'].indexOf(d.role) < 0) throw new Error('Invalid role');
      if (t.Role === 'Master Admin' && d.role !== 'Master Admin' &&
          rows('USERS').filter(r => r.Role === 'Master Admin' && r.Status === 'Approved').length <= 1)
        throw new Error('At least one approved Master Admin must remain');
      t.Role = d.role;
    }
    t.FullName = fullName;
    t.Username = username;
    if (d.newPassword) {
      if (String(d.newPassword).length < 6) throw new Error('Password must be at least 6 characters');
      t.Salt = Utilities.getUuid();
      t.PasswordHash = hash(String(d.newPassword), t.Salt);
    }
    t.UpdatedAt = now();
    setRow('USERS', t._row, t);
    audit(u, 'USER_ACCOUNT_UPDATE', t.UserID + ' ' + t.Username);
    return { UserID: t.UserID, FullName: t.FullName, Username: t.Username, Role: t.Role };
  },

  listUsers(d, u) {
    need(u, 'Admin');
    return rows('USERS').map(r => ({ UserID: r.UserID, FullName: r.FullName, Email: r.Email, Username: r.Username,
      Role: r.Role, Status: r.Status, CreatedAt: r.CreatedAt }));
  },

  setUserStatus(d, u) {
    need(u, 'Admin');
    if (['Approved', 'Denied'].indexOf(d.status) < 0) throw new Error('Invalid status');
    const t = rows('USERS').find(r => r.UserID === d.id);
    if (!t) throw new Error('User not found');
    if (t.UserID === u.id) throw new Error('You cannot change your own status');
    if (d.status === 'Approved') {
      const role = String(d.approvedRole || t.Role);
      if (['Master Admin', 'Admin', 'Bursar'].indexOf(role) < 0) throw new Error('Invalid approved role');
      t.Role = role;
    }
    t.Status = d.status; t.UpdatedAt = now(); setRow('USERS', t._row, t);
    audit(u, 'USER_' + d.status.toUpperCase(), t.Username + (d.status === 'Approved' ? ' as ' + t.Role : ''));
    let emailError = '';
    try { sendStatusMail(t, d.status === 'Approved'); }
    catch (error) { emailError = String(error.message || error); }
    return { emailed: !emailError, emailError: emailError };
  },

  deleteUser(d, u) {
    need(u, 'Admin');
    const t = rows('USERS').find(r => r.UserID === d.id);
    if (!t) throw new Error('User not found');
    if (t.UserID === u.id) throw new Error('Use Delete my account from your Profile');
    toBin('User', t.UserID, t.FullName + ' (' + t.Username + ')', clean(t), u);
    sh('USERS').deleteRow(t._row);
    audit(u, 'USER_DELETE', t.Username);
    return true;
  },

  accountDeletionOptions(d, u) {
    const users = rows('USERS');
    const masterCount = users.filter(r => r.Role === 'Master Admin' && r.Status === 'Approved').length;
    return {
      requiresTransfer: u.role === 'Master Admin' && masterCount <= 1,
      admins: u.role === 'Master Admin' ? users.filter(r => r.UserID !== u.id && r.Status === 'Approved' && r.Role === 'Admin')
        .map(r => ({ UserID: r.UserID, FullName: r.FullName, Username: r.Username }))
        : []
    };
  },

  deleteOwnAccount(d, u, token) {
    const users = rows('USERS');
    const current = users.find(r => r.UserID === u.id);
    if (!current) throw new Error('User not found');
    const masterCount = users.filter(r => r.Role === 'Master Admin' && r.Status === 'Approved').length;
    const requiresTransfer = current.Role === 'Master Admin' && masterCount <= 1;
    let target = null;
    if (d.transferToId) {
      if (current.Role !== 'Master Admin') throw new Error('Only a Master Admin can transfer ownership');
      target = users.find(r => r.UserID === d.transferToId && r.UserID !== current.UserID &&
        r.Role === 'Admin' && r.Status === 'Approved');
      if (!target) throw new Error('Select an approved Admin to receive ownership');
    }
    if (requiresTransfer && !target)
      throw new Error('Transfer ownership to an approved Admin before deleting the last Master Admin');
    if (target) {
      target.Role = 'Master Admin'; target.UpdatedAt = now();
      setRow('USERS', target._row, target);
      audit(u, 'MASTER_ADMIN_TRANSFER', current.UserID + ' -> ' + target.UserID);
    }
    toBin('User', current.UserID, current.FullName + ' (' + current.Username + ')', clean(current), u);
    sh('USERS').deleteRow(current._row);
    CacheService.getScriptCache().remove('S_' + token);
    audit(u, 'USER_SELF_DELETE', current.Username);
    return true;
  },

  /* ----- Students ----- */
  listStudents() { assignMissingRegistrationNumbers(); return rows('STUDENTS').map(clean); },

  listFormPayments() {
    return rows('Form Payment').map(row => ({
      row: row._row,
      FullName: row['Full Name'],
      Program: row.Program,
      Email: row.Email,
      RecordedBy: row['Recorded By'],
      Status: row.Status
    }));
  },

  saveFormPayment(d, u) {
    const applicantName = String(d.FullName || '').trim();
    const program = String(d.Program || '').trim();
    const recipientEmail = String(d.Email || '').trim().toLowerCase();
    if (!applicantName || PROGRAM_NAMES.indexOf(program) < 0)
      throw new Error('Enter the applicant full name and select a valid programme');
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(recipientEmail))
      throw new Error('Enter a valid email address for the application link');
    const applicationUrl = ScriptApp.getService().getUrl();
    if (!applicationUrl || !/^https:\/\/script\.google\.com\/macros\/s\/[^/?#]+\/exec$/i.test(applicationUrl))
      throw new Error('Deploy this Apps Script as a web app before sending registration form links.');

    const token = Utilities.getUuid() + Utilities.getUuid().replace(/-/g, '');
    const payment = {
      'Full Name': applicantName, Program: program, Email: recipientEmail, 'Recorded By': u.fullName,
      FormTokenHash: tokenDigest(token), Status: 'Form pending', RegistrationNumber: '', CreatedAt: now()
    };
    addRow('Form Payment', payment);

    const link = applicationUrl + '?apply=' + encodeURIComponent(token);
    let delivery;
    try {
      delivery = sendApplicationLinkEmail(payment, link);
    } catch (error) {
      delivery = { sent: false, error: String(error.message || error) };
    }
    audit(u, 'APPLICATION_LINK_SENT', applicantName + ' | ' + recipientEmail);
    return { emailSent: delivery.sent, emailError: delivery.error };
  },

  deleteFormPayment(d, u) {
    need(u, 'Master Admin');
    const record = rows('Form Payment').find(row => row._row === Number(d.row));
    if (!record) throw new Error('Form payment record was not found');
    sh('Form Payment').deleteRow(record._row);
    audit(u, 'FORM_PAYMENT_DELETE', record['Full Name'] + ' | ' + record.Email);
    return true;
  },

  listBankAccounts(d, u) {
    need(u, 'Master Admin');
    return rows('ACOUNT NUMBER').map(row => ({
      row: row._row,
      BankName: row['Bank Name'],
      AccountNumber: row['Account Number']
    }));
  },

  saveBankAccount(d, u) {
    need(u, 'Master Admin');
    const bankName = String(d.BankName || '').trim();
    const accountNumber = String(d.AccountNumber || '').trim();
    if (!bankName || !accountNumber) throw new Error('Enter both the bank name and account number');
    const record = { 'Bank Name': bankName, 'Account Number': accountNumber };
    if (d.row !== undefined && d.row !== '') {
      const existing = rows('ACOUNT NUMBER').find(row => row._row === Number(d.row));
      if (!existing) throw new Error('Bank account was not found');
      setRow('ACOUNT NUMBER', existing._row, record);
      audit(u, 'BANK_ACCOUNT_UPDATE', bankName);
      return { row: existing._row, BankName: bankName, AccountNumber: accountNumber };
    }
    addRow('ACOUNT NUMBER', record);
    const saved = rows('ACOUNT NUMBER').slice(-1)[0];
    audit(u, 'BANK_ACCOUNT_ADD', bankName);
    return { row: saved._row, BankName: bankName, AccountNumber: accountNumber };
  },

  deleteBankAccount(d, u) {
    need(u, 'Master Admin');
    const record = rows('ACOUNT NUMBER').find(row => row._row === Number(d.row));
    if (!record) throw new Error('Bank account was not found');
    sh('ACOUNT NUMBER').deleteRow(record._row);
    audit(u, 'BANK_ACCOUNT_DELETE', record['Bank Name']);
    return true;
  },

  getApplicationForm(d) {
    const payment = findFormPaymentByToken(d.token);
    if (!payment) throw new Error('This application link is invalid or has expired');
    if (payment.Status === 'Submitted')
      return { completed: true, alreadyCompleted: true, registrationNumber: payment.RegistrationNumber };
    if (payment.Status !== 'Form pending') throw new Error('This application link is no longer active');
    return { applicantName: payment['Full Name'], program: payment.Program };
  },

  submitApplicationForm(d) {
    const payment = findFormPaymentByToken(d.token);
    if (!payment) throw new Error('This application link is invalid or has expired');
    if (payment.Status === 'Submitted') {
      const existing = rows('STUDENTS').find(row => row.RegistrationNumber === payment.RegistrationNumber);
      return {
        completed: true, alreadyCompleted: true, student: existing ? clean(existing) : null,
        registrationNumber: payment.RegistrationNumber
      };
    }
    if (payment.Status !== 'Form pending') throw new Error('This application link is no longer active');

    const programIndex = PROGRAM_NAMES.indexOf(payment.Program);
    const studentData = Object.assign({}, d.student, {
      FullName: payment['Full Name'],
      ProgrammeLevel: programIndex < 13 ? 'Certificate' : 'Diploma',
      Programmes: payment.Program,
      ClientRef: 'FORM-' + payment._row,
      RegistrationNumber: '',
      StudentID: ''
    });
    validateApplicationSubmission(studentData);

    const result = ACTIONS.saveStudent(studentData, { fullName: 'Online Applicant', username: 'Online Applicant' });
    const student = result.student || result;
    payment.Status = 'Submitted';
    payment.RegistrationNumber = student.RegistrationNumber;
    setRow('Form Payment', payment._row, payment);
    audit(null, 'FORM_APPLICATION_SUBMITTED', payment['Full Name'] + ' ' + student.RegistrationNumber);
    return {
      completed: true, student: clean(student),
      acceptanceEmailSent: result.emailSent, acceptanceEmailError: result.emailError || ''
    };
  },

  downloadAcceptanceLetter(d, u) {
    const student = rows('STUDENTS').find(row => row.RegistrationNumber === String(d.registrationNumber || '').trim().toUpperCase());
    if (!student) throw new Error('Student registration was not found');
    return { student: clean(student), feeSchedule: buildFeeSchedule(student), bankAccounts: bankAccountList(), date: today(),
      stampDataUri: officialStampDataUri() };
  },

  emailRegistrationNumbers(d, u) {
    need(u, 'Admin');
    assignMissingRegistrationNumbers();
    const students = rows('STUDENTS');
    const validEmail = value => /^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(String(value || '').trim());
    const candidates = students.filter(student =>
      validEmail(student.Email) || validEmail(student.GuardianEmail));
    let remainingQuota = MailApp.getRemainingDailyQuota();
    let sent = 0, failed = 0, deferred = 0;
    candidates.forEach(student => {
      if (student.RegistrationEmailSent === 'Yes') return;
      const recipients = [student.Email, student.GuardianEmail].map(value => String(value || '').trim())
        .filter((value, index, list) => validEmail(value) && list.indexOf(value) === index);
      if (recipients.length > remainingQuota) {
        deferred++;
        return;
      }
      const result = sendStudentEmail(student, 'FBITI – Your registration number',
        'Your registration is on file. Please keep this number safe; it is required for your first fee payment.\n\n' +
        'Registration number: ' + student.RegistrationNumber);
      student.RegistrationEmailSent = result.sent ? 'Yes' : 'No';
      student.RegistrationEmailError = result.error;
      setRow('STUDENTS', student._row, student);
      if (result.sent) {
        sent++;
        remainingQuota -= recipients.length;
      } else failed++;
    });
    audit(u, 'REGISTRATION_NUMBERS_EMAIL', sent + ' sent, ' + failed + ' failed, ' + deferred + ' deferred');
    return { sent: sent, failed: failed, deferred: deferred, withoutEmail: students.length - candidates.length };
  },

  saveStudent(d, u) {
    assignMissingRegistrationNumbers();
    const rec = {};
    STUDENT_FIELDS.forEach(k => rec[k] = d[k] === undefined ? '' : String(d[k]).trim());
    if (!rec.FullName || !rec.Gender) throw new Error('Full name and gender are required');
    const requestedReg = String(d.RegistrationNumber || '').trim().toUpperCase();
    if (requestedReg || d.StudentID) {
      const ex = rows('STUDENTS').find(r => requestedReg
        ? String(r.RegistrationNumber).toUpperCase() === requestedReg
        : r.StudentID === d.StudentID);
      if (!ex) throw new Error('Student not found');
      rec.RegistrationNumber = ex.RegistrationNumber;
      rec.StudentID = ex.StudentID;
      rec.RecordedBy = ex.RecordedBy; rec.ClientRef = ex.ClientRef;
      rec.AcceptanceEmailSent = ex.AcceptanceEmailSent; rec.AcceptanceEmailError = ex.AcceptanceEmailError;
      rec.RegistrationEmailSent = ex.RegistrationEmailSent; rec.RegistrationEmailError = ex.RegistrationEmailError;
      rec.CreatedAt = ex.CreatedAt; rec.UpdatedAt = now();
      const previousEmails = studentEmailRecipients(ex);
      const addedEmails = studentEmailRecipients(rec).filter(email => previousEmails.indexOf(email) < 0);
      const currentEmails = studentEmailRecipients(rec);
      setRow('STUDENTS', ex._row, rec);
      rows('FEES PAYMENT').filter(f => f.StudentID === ex.StudentID).forEach(f => {   // keep fee rows in sync
        f.Name = rec.FullName; setRow('FEES PAYMENT', f._row, f);
      });
      audit(u, 'STUDENT_EDIT', rec.StudentID);
      if (!addedEmails.length) return rec;

      const feeSchedule = buildFeeSchedule(rec);
      let acceptanceEmail;
      try {
        const attachment = acceptanceLetterPdf(rec, feeSchedule, today(), bankAccountList());
        acceptanceEmail = sendStudentEmail(rec, 'FBITI – Letter of Acceptance',
          'Congratulations, ' + rec.FullName + '. Your application has been accepted. Your official Letter of Acceptance is attached as a PDF. ' +
          'Please review the programme and fee schedule, and follow the enrolment and payment instructions in the letter.\n\n' +
          feeScheduleText(feeSchedule), [attachment], [rec.Email]);
      } catch (error) {
        acceptanceEmail = { sent: false, error: 'Could not create the acceptance letter PDF: ' + String(error.message || error) };
      }
      rec.AcceptanceEmailSent = acceptanceEmail.sent ? 'Yes' : 'No';
      rec.AcceptanceEmailError = acceptanceEmail.error;

      const latest = latestStudentReceipt(rec.RegistrationNumber);
      let receiptEmail = null;
      if (latest.receipt) {
        try {
          receiptEmail = sendStudentEmail(rec, 'FBITI – Payment receipt ' + latest.receipt.receiptNumber,
            paymentEmailText(latest.receipt), [paymentReceiptPdf(latest.receipt)], currentEmails);
        } catch (error) {
          receiptEmail = { sent: false, error: 'Could not create the payment receipt PDF: ' + String(error.message || error) };
        }
        latest.record.PaymentEmailSent = receiptEmail.sent ? 'Yes' : 'No';
        latest.record.PaymentEmailError = receiptEmail.error;
        setRow('FEES PAYMENT', latest.record._row, latest.record);
      } else if (latest.error) {
        receiptEmail = { sent: false, error: latest.error };
      }
      setRow('STUDENTS', ex._row, rec);
      return {
        student: rec, updated: true,
        acceptanceEmailSent: acceptanceEmail.sent, acceptanceEmailError: acceptanceEmail.error,
        receiptEmailSent: receiptEmail ? receiptEmail.sent : null,
        receiptEmailError: receiptEmail ? receiptEmail.error : ''
      };
    }
    if (d.ClientRef) {
      const dup = rows('STUDENTS').find(r => r.ClientRef === d.ClientRef);
      if (dup) return { student: clean(dup), emailSent: dup.AcceptanceEmailSent === 'Yes',
        emailError: dup.AcceptanceEmailError || '', alreadySaved: true };
    }
    rec.StudentID = '';
    rec.RegistrationNumber = nextRegistrationNumber();
    rec.RecordedBy = u.fullName; rec.ClientRef = d.ClientRef || '';
    rec.CreatedAt = rec.UpdatedAt = now();
    addRow('STUDENTS', rec);
    audit(u, 'STUDENT_ADD', rec.RegistrationNumber);
    const feeSchedule = buildFeeSchedule(rec);
    let email;
    try {
      const attachment = acceptanceLetterPdf(rec, feeSchedule, today(), bankAccountList());
      email = sendStudentEmail(rec, 'FBITI – Letter of Acceptance',
        'Congratulations, ' + rec.FullName + '. Your application has been accepted. Your official Letter of Acceptance is attached as a PDF. ' +
        'Please review the programme and fee schedule, and follow the enrolment and payment instructions in the letter.\n\n' +
        feeScheduleText(feeSchedule), [attachment], [rec.Email]);
    } catch (error) {
      email = { sent: false, error: 'Could not create the acceptance letter PDF: ' + String(error.message || error) };
    }
    rec.AcceptanceEmailSent = email.sent ? 'Yes' : 'No';
    rec.AcceptanceEmailError = email.error;
    const savedStudent = rows('STUDENTS').find(r => r.RegistrationNumber === rec.RegistrationNumber);
    if (savedStudent) setRow('STUDENTS', savedStudent._row, rec);
    return { student: rec, emailSent: email.sent, emailError: email.error };
  },

  deleteStudent(d, u) {
    const ex = rows('STUDENTS').find(r => r.RegistrationNumber === d.id || r.StudentID === d.id);
    if (!ex) throw new Error('Student not found');
    toBin('Student', ex.RegistrationNumber, ex.RegistrationNumber + ' – ' + ex.FullName, clean(ex), u);
    sh('STUDENTS').deleteRow(ex._row);
    audit(u, 'STUDENT_DELETE', ex.RegistrationNumber);
    return { hasFees: rows('FEES PAYMENT').some(f => f.StudentID === ex.StudentID) };
  },

  /* ----- Fees (never erased – voided) ----- */
  listFees() { return rows('FEES PAYMENT').map(clean); },

  listProgrammeFees() {
    const current = rows('PROGRAMME FEES');
    return PROGRAM_NAMES.flatMap(Program => SEMESTER_GROUPS.map(SemesterGroup => {
      const fee = current.find(r => normalizeProgramme(r.Program) === normalizeProgramme(Program) &&
        normalizeSemesterGroup(r.SemesterGroup) === SemesterGroup);
      return { Program: Program, SemesterGroup: SemesterGroup, TotalFees: fee ? num(fee.TotalFees) : '' };
    }));
  },

  getProgrammeFee(d) {
    const program = String(d.Program || '').trim();
    const semesterGroup = normalizeSemesterGroup(d.SemesterGroup);
    if (PROGRAM_NAMES.indexOf(program) < 0 || SEMESTER_GROUPS.indexOf(semesterGroup) < 0)
      throw new Error('Select a valid programme and semester group');
    const fee = rows('PROGRAMME FEES').find(row =>
      normalizeProgramme(row.Program) === normalizeProgramme(program) &&
      normalizeSemesterGroup(row.SemesterGroup) === semesterGroup);
    return { Program: program, SemesterGroup: semesterGroup, TotalFees: fee ? num(fee.TotalFees) : '' };
  },

  saveProgrammeFees(d, u) {
    need(u, 'Admin');
    if (!Array.isArray(d.items))
      throw new Error('Programme fees must be submitted as a list');
    const entered = d.items.filter(item => String(item.TotalFees === undefined ? '' : item.TotalFees).trim() !== '');
    if (!entered.length) return { saved: 0 };
    const seen = {};
    entered.forEach(item => {
      const program = String(item.Program || '').trim();
      const semesterGroup = normalizeSemesterGroup(item.SemesterGroup);
      if (PROGRAM_NAMES.indexOf(program) < 0 || programmeGroups(program).indexOf(semesterGroup) < 0)
        throw new Error('Invalid programme or semester group for that programme level');
      const key = normalizeProgramme(program) + '|' + semesterGroup;
      const fee = num(item.TotalFees);
      if (seen[key] || fee <= 0) throw new Error('Every entered programme and semester fee must be greater than zero');
      seen[key] = true;
    });
    const existing = rows('PROGRAMME FEES');
    entered.forEach(item => {
      const program = String(item.Program || '').trim();
      const semesterGroup = normalizeSemesterGroup(item.SemesterGroup);
      const row = existing.find(r => normalizeProgramme(r.Program) === normalizeProgramme(program) &&
        normalizeSemesterGroup(r.SemesterGroup) === semesterGroup);
      const rec = { Program: program, SemesterGroup: semesterGroup, TotalFees: num(item.TotalFees),
        UpdatedAt: now(), UpdatedBy: u.fullName };
      if (row) setRow('PROGRAMME FEES', row._row, rec);
      else addRow('PROGRAMME FEES', rec);
    });
    audit(u, 'PROGRAMME_FEES_UPDATE', entered.length + ' programme/semester fees updated');
    return { saved: entered.length };
  },

  saveFee(d, u) {
    const all = rows('FEES PAYMENT');
    if (d.ClientRef) {
      const duplicate = all.map(r => {
        const history = parseReceiptHistory(r);
        const receipt = history.find(item => item.clientRef === d.ClientRef);
        return receipt ? { record: r, receipt: receipt } : r.ClientRef === d.ClientRef ? { record: r, receipt: history[history.length - 1] || null } : null;
      }).find(Boolean);
      if (duplicate) {
        return { record: clean(duplicate.record), receipt: duplicate.receipt, StudentID: duplicate.record.StudentID,
          emailSent: duplicate.record.PaymentEmailSent === 'Yes', emailError: duplicate.record.PaymentEmailError || '', alreadySaved: true };
      }
    }
    assignMissingRegistrationNumbers();
    const idInput = String(d.StudentID || '').trim().toUpperCase();
    const studentId = idInput ? normalizeStudentId(idInput) : '';
    const regInput = String(d.RegistrationNumber || '').trim().toUpperCase();
    let st = studentId
      ? rows('STUDENTS').find(s => String(s.StudentID).toUpperCase() === studentId)
      : rows('STUDENTS').find(s => String(s.RegistrationNumber).toUpperCase() === regInput);
    if (!st) throw new Error(studentId ? 'Student ID not found' : 'Registration number not found');
    if (!studentId && st.StudentID)
      throw new Error('This student has already made a first payment. Enter student ID ' + st.StudentID + ' for later payments.');
    if (studentId && regInput && st.RegistrationNumber !== regInput)
      throw new Error('The student ID and registration number do not match');
    const program = String(d.Program || '').trim();
    const semesterGroup = normalizeSemesterGroup(d.SemesterGroup);
    const registeredProgrammes = split([st.Programmes, st.Programme, st.Program, st.Course].filter(Boolean).join(' | '));
    if (!registeredProgrammes.some(name => name.toLowerCase() === program.toLowerCase()))
      throw new Error('Select a programme registered for this student');
    if (programmeGroups(program).indexOf(semesterGroup) < 0)
      throw new Error('Select a semester group available for this programme level');
    const configuredFee = rows('PROGRAMME FEES').find(r => normalizeProgramme(r.Program) === normalizeProgramme(program) &&
      normalizeSemesterGroup(r.SemesterGroup) === normalizeSemesterGroup(semesterGroup));
    const total = configuredFee ? num(configuredFee.TotalFees) : 0;
    if (total <= 0) throw new Error('The fee for this programme and semester group has not been set by the Master Admin');
    const allStudentPayments = all.filter(r => r.RegistrationNumber === st.RegistrationNumber);
    const ex = allStudentPayments.find(r => r.Program === program && r.SemesterGroup === semesterGroup && r.Status !== 'Voided');
    const oldPaid = ex ? num(ex.TotalPaid) : 0;
    const rec = { FeeID: ex ? ex.FeeID : nextId('PAY-', all.map(r => r.FeeID), 4),
      RegistrationNumber: st.RegistrationNumber, StudentID: st.StudentID || '', Name: st.FullName,
      Program: program, SemesterGroup: semesterGroup, TotalFees: total,
      ReceiptHistory: ex ? ex.ReceiptHistory || '' : '' };
    let paid = 0;
    for (let i = 1; i <= 5; i++) {
      const a = num(d['P' + i + '_Amount']);
      if (ex && num(ex['P' + i + '_Amount']) > 0 &&
          (a !== num(ex['P' + i + '_Amount']) ||
           String(d['P' + i + '_Date'] || '') !== String(ex['P' + i + '_Date'] || '') ||
           String(d['P' + i + '_Bank'] || '').trim() !== String(ex['P' + i + '_Bank'] || '').trim() ||
           String(d['P' + i + '_Slip'] || '').trim() !== String(ex['P' + i + '_Slip'] || '').trim()))
        throw new Error('Previous installments cannot be changed when recording a new payment');
      rec['P' + i + '_Amount'] = a || '';
      rec['P' + i + '_Date'] = a ? (d['P' + i + '_Date'] || (ex && ex['P' + i + '_Date']) || today()) : '';
      rec['P' + i + '_Bank'] = a ? String(d['P' + i + '_Bank'] || '').trim() : '';
      rec['P' + i + '_Slip'] = a ? String(d['P' + i + '_Slip'] || '').trim() : '';
      paid += a;
    }
    if (paid <= oldPaid) throw new Error('Enter a new payment amount greater than the amount already paid for this semester group');
    if (paid > total) throw new Error('Total paid cannot exceed total fees');
    const currentPayment = paid - oldPaid;
    const previousInstallments = ex ? PAY_FIELDS.filter((field, index) => index % 4 === 0)
      .map(field => {
        const amount = num(ex[field]);
        const index = Number(field.match(/^P(\d+)_/)[1]);
        return amount > 0 ? { number: index, amount: amount, date: ex['P' + index + '_Date'] } : null;
      }).filter(Boolean) : [];
    const currentInstallments = [];
    for (let i = 1; i <= 5; i++) {
      const amount = num(rec['P' + i + '_Amount']);
      if (amount > 0 && (!ex || !num(ex['P' + i + '_Amount'])))
        currentInstallments.push({ number: i, amount: amount, date: rec['P' + i + '_Date'] });
    }
    rec.TotalPaid = paid; rec.Balance = total - paid; rec.Status = 'Active';
    rec.VoidReason = ''; rec.VoidedBy = '';
    if (ex) {
      rec.RecordedBy = u.fullName; rec.ClientRef = d.ClientRef || ''; rec.CreatedAt = ex.CreatedAt; rec.UpdatedAt = now();
      setRow('FEES PAYMENT', ex._row, rec);
      audit(u, 'FEE_UPDATE', rec.FeeID + ' paid ' + ex.TotalPaid + ' -> ' + paid + ' by ' + u.fullName);
    } else {
      rec.RecordedBy = u.fullName; rec.ClientRef = d.ClientRef || ''; rec.CreatedAt = rec.UpdatedAt = now();
      if (!st.StudentID) {
        st.StudentID = nextStudentId();
        st.UpdatedAt = now();
        setRow('STUDENTS', st._row, st);
        rec.StudentID = st.StudentID;
      }
      addRow('FEES PAYMENT', rec);
      audit(u, 'FEE_ADD', rec.FeeID + ' paid ' + paid);
    }
    const receipt = {
      receiptNumber: rec.FeeID + '-R' + currentInstallments[0].number,
      date: now(),
      registrationNumber: st.RegistrationNumber,
      studentId: st.StudentID,
      name: st.FullName,
      program: program,
      semesterGroup: semesterGroup,
      currentInstallments: currentInstallments,
      previousInstallments: previousInstallments,
      amountPaid: currentPayment,
      totalPaid: paid,
      totalFees: total,
      balance: rec.Balance,
      recordedBy: u.fullName,
      clientRef: d.ClientRef || ''
    };
    rec.LastReceipt = JSON.stringify(receipt);
    const receiptHistory = ex ? parseReceiptHistory(ex) : [];
    receiptHistory.push(receipt);
    rec.ReceiptHistory = JSON.stringify(receiptHistory);
    let email;
    try {
      email = sendStudentEmail(st, 'FBITI – Payment receipt ' + receipt.receiptNumber,
        paymentEmailText(receipt), [paymentReceiptPdf(receipt)]);
    } catch (error) {
      email = { sent: false, error: 'Could not create the payment receipt PDF: ' + String(error.message || error) };
    }
    rec.PaymentEmailSent = email.sent ? 'Yes' : 'No';
    rec.PaymentEmailError = email.error;
    const savedFee = rows('FEES PAYMENT').find(r => r.FeeID === rec.FeeID);
    if (savedFee) setRow('FEES PAYMENT', savedFee._row, rec);
    return { record: rec, receipt: receipt, StudentID: st.StudentID, emailSent: email.sent, emailError: email.error };
  },

  voidFee(d, u) {
    if (!String(d.reason || '').trim()) throw new Error('A reason is required to void a payment record');
    const r = rows('FEES PAYMENT').find(x => x.FeeID === d.id);
    if (!r) throw new Error('Record not found');
    r.Status = 'Voided'; r.VoidReason = d.reason.trim(); r.VoidedBy = u.fullName; r.UpdatedAt = now();
    setRow('FEES PAYMENT', r._row, r); audit(u, 'FEE_VOID', r.FeeID + ': ' + d.reason);
    return true;
  },

  reinstateFee(d, u) {
    need(u, 'Admin');
    const all = rows('FEES PAYMENT'), r = all.find(x => x.FeeID === d.id);
    if (!r) throw new Error('Record not found');
    if (all.some(x => x.StudentID === r.StudentID && x.Status !== 'Voided')) throw new Error('This student already has an active fee record');
    r.Status = 'Active'; r.VoidReason = ''; r.VoidedBy = ''; r.UpdatedAt = now();
    setRow('FEES PAYMENT', r._row, r); audit(u, 'FEE_REINSTATE', r.FeeID);
    return true;
  },

  /* ----- Expenditure ----- */
  listExpenditure() { return rows('EXPENDITURE').map(clean); },

  saveExpenditure(d, u) { return saveExpenditureRecord(d, u); },

  saveExpenditures(d, u) {
    if (!Array.isArray(d.items) || !d.items.length) throw new Error('Add at least one expenditure');
    const refs = d.items.map(item => String(item.ClientRef || ''));
    if (refs.some(ref => !ref) || new Set(refs).size !== refs.length) throw new Error('Invalid expenditure references');
    d.items.forEach(validateExpenditure);
    return d.items.map(item => saveExpenditureRecord(item, u));
  },

  voidExpenditure(d, u) {
    if (!String(d.reason || '').trim()) throw new Error('A reason is required to void an expenditure record');
    const r = rows('EXPENDITURE').find(x => x.ExpID === d.id);
    if (!r) throw new Error('Record not found');
    r.Status = 'Voided'; r.VoidReason = d.reason.trim(); r.VoidedBy = u.fullName;
    setRow('EXPENDITURE', r._row, r); audit(u, 'EXP_VOID', r.ExpID + ': ' + d.reason);
    return true;
  },

  deleteExpenditure(d, u) {
    need(u, 'Master Admin');
    const r = rows('EXPENDITURE').find(x => x.ExpID === d.id);
    if (!r) throw new Error('Record not found');
    toBin('Expenditure', r.ExpID, r.ExpID + ' – ' + r.Name, clean(r), u);
    sh('EXPENDITURE').deleteRow(r._row);
    audit(u, 'EXP_DELETE', r.ExpID);
    return true;
  },

  reinstateExpenditure(d, u) {
    need(u, 'Admin');
    const r = rows('EXPENDITURE').find(x => x.ExpID === d.id);
    if (!r) throw new Error('Record not found');
    r.Status = 'Active'; r.VoidReason = ''; r.VoidedBy = '';
    setRow('EXPENDITURE', r._row, r); audit(u, 'EXP_REINSTATE', r.ExpID);
    return true;
  },

  /* ----- Recycle bin (Master Admin) ----- */
  listBin(d, u) {
    need(u, 'Master Admin');
    const limit = Date.now() - CFG.BIN_DAYS * 86400000;
    const s = sh('RECYCLE BIN');
    rows('RECYCLE BIN').filter(r => r.Type !== 'Expenditure' && Date.parse(r.DeletedAt) < limit).map(r => r._row).sort((a, b) => b - a)
      .forEach(r => s.deleteRow(r));                       // auto-purge expired items
    return rows('RECYCLE BIN').map(r => ({ BinID: r.BinID, Type: r.Type, OriginalID: r.OriginalID, Label: r.Label,
      DeletedBy: r.DeletedBy, DeletedAt: r.DeletedAt,
      ExpiresAt: r.Type === 'Expenditure' ? '' : new Date(Date.parse(r.DeletedAt) + CFG.BIN_DAYS * 86400000).toISOString() }));
  },

  restoreBin(d, u) {
    need(u, 'Master Admin');
    const b = rows('RECYCLE BIN').find(r => r.BinID === d.id);
    if (!b) throw new Error('Item not found');
    const data = JSON.parse(b.Data);
    if (b.Type === 'Student') {
      if (rows('STUDENTS').some(r => (data.StudentID && r.StudentID === data.StudentID) ||
          (data.RegistrationNumber && r.RegistrationNumber === data.RegistrationNumber)))
        throw new Error('A student with this registration number or ID already exists');
      data.UpdatedAt = now(); addRow('STUDENTS', data);
    } else if (b.Type === 'User') {
      const us = rows('USERS');
      if (us.some(r => String(r.Username).toLowerCase() === String(data.Username).toLowerCase() || String(r.Email).toLowerCase() === String(data.Email).toLowerCase()))
        throw new Error('Username or email is already in use');
      data.UpdatedAt = now(); addRow('USERS', data);
    } else if (b.Type === 'Expenditure') {
      if (rows('EXPENDITURE').some(r => r.ExpID === data.ExpID))
        throw new Error('An expenditure record with this ID already exists');
      addRow('EXPENDITURE', data);
    } else {
      throw new Error('This item type cannot be restored');
    }
    sh('RECYCLE BIN').deleteRow(b._row);
    audit(u, 'RESTORE', b.Type + ' ' + b.OriginalID);
    return true;
  },

  purgeBin(d, u) {
    need(u, 'Master Admin');
    const b = rows('RECYCLE BIN').find(r => r.BinID === d.id);
    if (!b) throw new Error('Item not found');
    sh('RECYCLE BIN').deleteRow(b._row); audit(u, 'PURGE', b.Type + ' ' + b.OriginalID);
    return true;
  }
};

/* ---------- Internal helpers ---------- */
function validateExpenditure(d) {
  const name = String(d.Name || '').trim(), amount = num(d.Amount), date = String(d.Date || '');
  if (!name) throw new Error('Name is required');
  if (amount <= 0) throw new Error('Enter a valid amount');
  if (date) {
    if (!/^\d{4}-\d{2}-\d{2}$/.test(date)) throw new Error('Enter a valid expenditure date');
    const parsedDate = new Date(date + 'T00:00:00Z');
    if (isNaN(parsedDate.getTime()) || parsedDate.toISOString().slice(0, 10) !== date)
      throw new Error('Enter a valid expenditure date');
  }
}
function saveExpenditureRecord(d, u) {
  const all = rows('EXPENDITURE');
  if (d.ClientRef) {
    const duplicate = all.find(r => r.ClientRef === d.ClientRef);
    if (duplicate) return clean(duplicate);
  }
  validateExpenditure(d);
  const deletedIds = rows('RECYCLE BIN').filter(r => r.Type === 'Expenditure').map(r => r.OriginalID);
  const rec = { ExpID: nextId('EXP-', all.map(r => r.ExpID).concat(deletedIds), 4), Date: d.Date || today(),
    Name: String(d.Name).trim(), Description: String(d.Description || '').trim(), Amount: num(d.Amount),
    RecordedBy: u.fullName, Status: 'Active', ClientRef: d.ClientRef || '', CreatedAt: now() };
  addRow('EXPENDITURE', rec);
  audit(u, 'EXP_ADD', rec.ExpID + ' ' + rec.Amount);
  return rec;
}

function toBin(type, id, label, data, u) {
  addRow('RECYCLE BIN', { BinID: 'BIN-' + uid8(), Type: type, OriginalID: id, Label: label,
    DeletedBy: u.fullName, DeletedAt: now(), Data: JSON.stringify(data) });
}
function nextId(prefix, ids, pad) {
  let max = 0; ids.forEach(i => max = Math.max(max, parseInt(String(i).replace(/\D/g, '')) || 0));
  return prefix + String(max + 1).padStart(pad, '0');
}
function nextStudentId() {   // FBITI-001, 002 … never re-used, even after deletion
  const ids = rows('STUDENTS').map(r => r.StudentID)
    .concat(rows('RECYCLE BIN').filter(r => r.Type === 'Student').map(r => r.OriginalID));
  return nextId('FBITI-', ids, 3);
}
function nextRegistrationNumber() {
  const active = rows('STUDENTS').map(r => r.RegistrationNumber);
  const deleted = rows('RECYCLE BIN').filter(r => r.Type === 'Student').map(r => {
    try { return JSON.parse(r.Data).RegistrationNumber; } catch (e) { return ''; }
  });
  return nextId('REG-', active.concat(deleted).filter(Boolean), 3);
}
function assignMissingRegistrationNumbers() {
  const active = rows('STUDENTS');
  const feeStudentIds = rows('FEES PAYMENT').map(r => r.StudentID).filter(Boolean);
  const deleted = rows('RECYCLE BIN').filter(r => r.Type === 'Student').map(r => {
    try { return JSON.parse(r.Data).RegistrationNumber; } catch (e) { return ''; }
  });
  const used = active.map(r => r.RegistrationNumber).concat(deleted).filter(Boolean);
  active.forEach(r => {
    let changed = false;
    if (r.StudentID && feeStudentIds.indexOf(r.StudentID) < 0) {
      r.StudentID = '';
      changed = true;
    }
    if (!r.RegistrationNumber) {
      r.RegistrationNumber = nextId('REG-', used, 3);
      used.push(r.RegistrationNumber);
      changed = true;
    }
    if (changed) setRow('STUDENTS', r._row, r);
  });
}
function normalizeStudentId(value) {
  const id = String(value || '').trim().toUpperCase();
  if (/^\d+$/.test(id)) return 'FBITI-' + id.padStart(3, '0');
  if (/^FBITI-\d+$/.test(id)) return id;
  throw new Error('Enter only the student ID number after the FBITI- prefix');
}
function moneyText(value) {
  return 'Le ' + num(value).toFixed(2);
}
function parseReceiptHistory(record) {
  const history = record.ReceiptHistory ? JSON.parse(record.ReceiptHistory) : [];
  if (!Array.isArray(history)) throw new Error('Invalid receipt history for payment ' + record.FeeID);
  if (!history.length && record.LastReceipt) history.push(JSON.parse(record.LastReceipt));
  return history;
}
function latestStudentReceipt(registrationNumber) {
  let latest = null;
  const errors = [];
  rows('FEES PAYMENT').filter(record => record.RegistrationNumber === registrationNumber).forEach(record => {
    try {
      const history = record.LastReceipt ? [JSON.parse(record.LastReceipt)] : parseReceiptHistory(record);
      const receipt = history[history.length - 1];
      if (receipt) {
        const time = Date.parse(receipt.date) || 0;
        if (!latest || time >= latest.time) latest = { record: record, receipt: receipt, time: time };
      }
    } catch (error) {
      errors.push('Could not read payment receipt ' + record.FeeID + ': ' + String(error.message || error));
    }
  });
  return latest ? { record: latest.record, receipt: latest.receipt, error: '' } :
    { record: null, receipt: null, error: errors.join('; ') };
}
function programmeSemesterGroups(level) {
  const normalized = String(level || '').trim().toLowerCase();
  if (normalized === 'certificate') return SEMESTER_GROUPS.slice(0, 1);
  if (normalized === 'diploma') return SEMESTER_GROUPS.slice(0, 3);
  return SEMESTER_GROUPS.slice();
}
function buildFeeSchedule(student) {
  const groups = programmeSemesterGroups(student.ProgrammeLevel);
  const configured = rows('PROGRAMME FEES');
  const programmes = split(student.Programmes).map(program => {
    const fees = groups.map(group => {
      const row = configured.find(item => item.Program === program && item.SemesterGroup === group);
      return row && num(row.TotalFees) > 0 ? num(row.TotalFees) : null;
    });
    const complete = fees.every(fee => fee !== null);
    return { program: program, fees: fees, total: complete ? fees.reduce((sum, fee) => sum + fee, 0) : null };
  });
  const complete = programmes.length > 0 && programmes.every(program => program.total !== null);
  const initialComplete = programmes.length > 0 && programmes.every(program => program.fees.length && program.fees[0] !== null);
  return {
    groups: groups,
    programmes: programmes,
    initialDue: initialComplete ? programmes.reduce((sum, program) => sum + program.fees[0], 0) : null,
    total: complete ? programmes.reduce((sum, program) => sum + program.total, 0) : null
  };
}
function feeScheduleText(schedule) {
  const lines = ['Programme fee schedule (' + schedule.groups.length * 2 + ' semesters):',
    'Initial tuition due (' + (schedule.groups[0] || 'first semester group') + '): ' +
      (schedule.initialDue === null ? 'Pending fee setup' : moneyText(schedule.initialDue))];
  schedule.programmes.forEach(program => {
    lines.push(program.program);
    schedule.groups.forEach((group, i) => lines.push('  ' + group + ': ' +
      (program.fees[i] === null ? 'Not configured' : moneyText(program.fees[i]))));
    lines.push('  Programme total: ' + (program.total === null ? 'Pending fee setup' : moneyText(program.total)));
  });
  lines.push('Total fees for all selected programmes: ' +
    (schedule.total === null ? 'Pending fee setup' : moneyText(schedule.total)));
  return lines.join('\n');
}
function legacyAcceptanceLetterPdf(student, feeSchedule, date) {
  const headers = feeSchedule.groups.map(group => '<th>' + escapeHtml(group) + '</th>').join('');
  const programmeRows = feeSchedule.programmes.map(program => '<tr><td>' + escapeHtml(program.program) + '</td>' +
    program.fees.map(fee => '<td class="num">' + (fee === null ? 'Not configured' : escapeHtml(moneyText(fee))) + '</td>').join('') +
    '<td class="num"><b>' + (program.total === null ? 'Pending fee setup' : escapeHtml(moneyText(program.total))) + '</b></td></tr>').join('');
  const total = feeSchedule.total === null ? 'Pending fee setup' : escapeHtml(moneyText(feeSchedule.total));
  const initialDue = feeSchedule.initialDue === null ? 'Pending fee setup' : escapeHtml(moneyText(feeSchedule.initialDue));
  const stamp = officialStampDataUri();
  const html = '<!doctype html><html><head><meta charset="utf-8"><style>' +
    '@page{size:A4 portrait;margin:17mm}*{-webkit-print-color-adjust:exact;print-color-adjust:exact}' +
    'html,body{background:#fff!important}body{font-family:Arial,sans-serif;color:#10213f;font-size:10pt;line-height:1.5}' +
    'h1{font-size:20pt;color:#0b2a5b;margin:0}h2{font-size:11pt;color:#0b2a5b;margin:12px 0 6px}' +
